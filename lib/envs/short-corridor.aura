; envs/short-corridor.aura — Example 13.1, the short corridor with switched actions.
;
; Three non-terminal states 0, 1, 2 and a terminal state 3; the agent starts in 0.
; Every step pays -1 (gamma = 1). Action 1 = right, 0 = left. In states 0 and 2 the
; actions do what they say (left in state 0 stays put); in state 1 they are
; switched (right goes to 0, left goes to 2). All states look the same to the
; policy: x(s, right) = (1, 0), x(s, left) = (0, 1).
;
; With p = pi(right) in every state, the start value is
;   v(0) = (2p - 4) / (p (1 - p)),
; maximised at p* = 2 - sqrt 2 = 0.5858 with v* = -11.657 (Exercise 13.1).

(export sc-start sc-terminal sc-step sc-true-value sc-best-p)

(define sc-start 0)
(define sc-terminal 3)

; (sc-step s a) -> next state
(define (sc-step s a)
  (cond ((= s 0) (if (= a 1) 1 0))
        ((= s 1) (if (= a 1) 0 2))
        (else (if (= a 1) 3 1))))

; exact start-state value of the policy that goes right with probability p
(define (sc-true-value p)
  (if (<= p 0.0) -1000000.0
      (if (>= p 1.0) -1000000.0
          (/ (- (* 2.0 p) 4.0) (* p (- 1.0 p))))))

(define sc-best-p (- 2.0 (sqrt 2.0)))
