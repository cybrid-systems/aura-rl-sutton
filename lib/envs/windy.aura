; envs/windy.aura — Example 6.5 windy gridworld, 7×10.
; Start (3,0), goal (3,7). The wind in column j pushes the agent up by
; wind[j] cells (applied from the current column, then clipped to the grid).
; Every step pays -1 until the goal. Actions: 0=up 1=down 2=left 3=right.

(require "envs/gridworld" all:)
(require "rl/tuple" all:)

(export wg-rows wg-cols wg-start wg-goal wg-step)

(define wg-rows 7)
(define wg-cols 10)
(define wg-start (gw-index 10 3 0))
(define wg-goal (gw-index 10 3 7))
(define wg-wind (vector 0 0 0 1 1 1 2 2 1 0))

(define (clip x lo hi) (max lo (min hi x)))

; (wg-step s a) → (list s' reward done?)
(define (wg-step s a)
  (let* ((i (gw-row wg-cols s))
         (j (gw-col wg-cols s))
         (ni (clip (- (+ i (gw-di a)) (vector-ref wg-wind j)) 0 (- wg-rows 1)))
         (nj (clip (+ j (gw-dj a)) 0 (- wg-cols 1)))
         (s2 (gw-index wg-cols ni nj)))
    (tup3 s2 -1 (= s2 wg-goal))))
