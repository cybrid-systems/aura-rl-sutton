; rl/check.aura — tiny test oracle. Prints PASS/FAIL lines; scripts/run_tests.sh
; fails the run when any FAIL line appears (Aura has no (exit n) yet).

(export check-near check-true check-range)

(define (check-near name actual expected tol)
  (if (<= (abs (- actual expected)) tol)
      (begin (display "PASS ") (display name) (newline) #t)
      (begin (display "FAIL ") (display name) (display ": got ") (display actual)
             (display " expected ") (display expected) (display " ±") (display tol)
             (newline) #f)))

(define (check-true name ok)
  (if ok
      (begin (display "PASS ") (display name) (newline) #t)
      (begin (display "FAIL ") (display name) (newline) #f)))

(define (check-range name actual lo hi)
  (if (and (>= actual lo) (<= actual hi))
      (begin (display "PASS ") (display name) (newline) #t)
      (begin (display "FAIL ") (display name) (display ": got ") (display actual)
             (display " not in [") (display lo) (display ", ") (display hi) (display "]")
             (newline) #f)))
