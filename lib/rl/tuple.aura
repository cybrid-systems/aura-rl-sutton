; rl/tuple.aura — fixed-arity list constructors built from cons.
;
; Workaround: the `list` primitive reserves pairs_ to exactly size+n on every
; call (pmr vector on a monotonic arena), so N calls cost O(N^2) memory/time
; (cybrid-systems/aura#4453).
; Hot paths here build small lists with cons instead. See IMPROVEMENTS.md.

(export tup2 tup3 tup4)

(define (tup2 a b) (cons a (cons b '())))
(define (tup3 a b c) (cons a (cons b (cons c '()))))
(define (tup4 a b c d) (cons a (cons b (cons c (cons d '())))))
