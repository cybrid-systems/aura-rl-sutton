; rl/tuple.aura — fixed-arity list constructors built from cons.
;
; The O(N^2) growth of `list` (cybrid-systems/aura#4453) is fixed at 695c58f5d,
; but pairs built by `list` / `reverse` are still not reclaimed in file mode
; (800 000 four-element lists: list 233 MB peak, cons 93 MB), while cons pairs
; are. Hot paths keep building small lists with cons. See IMPROVEMENTS.md.

(export tup2 tup3 tup4 tup-reverse)

(define (tup2 a b) (cons a (cons b '())))
(define (tup3 a b c) (cons a (cons b (cons c '()))))
(define (tup4 a b c d) (cons a (cons b (cons c (cons d '())))))

; cons-built reverse (the `reverse` primitive has the same reserve pattern as `list`).
(define (tup-reverse lst)
  (let lp ((l lst) (acc '()))
    (if (null? l) acc (lp (cdr l) (cons (car l) acc)))))
