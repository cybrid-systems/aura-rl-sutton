; Chapter 7 — n-step TD on the 19-state random walk (Example 7.1, Figure 7.2).
; Left terminal pays −1, right +1, γ = 1, V initialised to 0. Performance is the
; RMS error over the 19 states, averaged over the first RL_EPISODES episodes and
; over runs. Intermediate n (4–8) does best; large α hurts large n.
;
; Knobs: RL_RUNS (default 10; book 100), RL_EPISODES (default 10, as in the book), RL_SEED.

(require "rl/rng" all:)
(require "rl/vec" all:)
(require "rl/knobs" all:)
(require "algos/nstep" all:)

(define runs (env-int "RL_RUNS" 10))
(define episodes (env-int "RL_EPISODES" 10))
(rng-seed! (env-int "RL_SEED" 2026))

(define ns (cons 1 (cons 2 (cons 4 (cons 8 (cons 16 '()))))))
(define alphas (cons 0.1 (cons 0.2 (cons 0.4 (cons 0.6 (cons 0.8 (cons 1.0 '())))))))

(display "Figure 7.2 — n-step TD, 19-state random walk: RMS error over the first ")
(display episodes) (display " episodes, ") (display runs) (display " runs") (newline)
(display "      n ")
(define (hdr l) (if (null? l) #t (begin (display (string-pad-left (string-append "a=" (number->string (car l))) 8)) (hdr (cdr l)))))
(hdr alphas) (newline)
(define (cols n l)
  (if (null? l) #t
      (begin (display (string-pad-left (number->string (round-to (ns-td-rms! 19 n (car l) runs episodes) 3)) 8))
             (cols n (cdr l)))))
(define (rows l)
  (if (null? l) #t
      (begin (display (string-pad-left (number->string (car l)) 7)) (display " ")
             (cols (car l) alphas) (newline) (rows (cdr l)))))
(rows ns)
(display "done") (newline)
