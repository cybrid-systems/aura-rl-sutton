; Chapter 10 — episodic semi-gradient n-step Sarsa on mountain car (Section 10.2,
; Figure 10.3): one-step Sarsa (alpha = 0.5/8) vs 8-step Sarsa (alpha = 0.3/8),
; steps per episode. The book finds n = 8 learns faster and reaches a better
; asymptote.
;
; Knobs: RL_RUNS (default 1; book 100), RL_EPISODES (default 100; book 500),
; RL_CAP (20000), RL_SEED.

(require "rl/rng" all:)
(require "rl/vec" all:)
(require "rl/knobs" all:)
(require "algos/semigrad-sarsa" all:)

(define runs (env-int "RL_RUNS" 1))
(define episodes (env-int "RL_EPISODES" 100))
(define cap (env-int "RL_CAP" 20000))
(rng-seed! (env-int "RL_SEED" 2026))

(define (run-eps a c k)
  (if (< k episodes) (begin (vec-add-at! c k (* 1.0 (sarsa-episode! a cap))) (run-eps a c (+ k 1))) c))
(define (run-runs n alpha c r) (if (< r runs) (begin (run-eps (sarsa-new alpha n) c 0) (run-runs n alpha c (+ r 1))) c))
(define (curve-for n alpha) (vec-scale! (run-runs n alpha (make-vector episodes 0.0) 0) (/ 1.0 runs)))
(define (sum-range v i hi acc) (if (< i hi) (sum-range v (+ i 1) hi (+ acc (vector-ref v i))) acc))
(define (avg-of v lo hi) (/ (sum-range v lo hi 0.0) (* 1.0 (- hi lo))))

(define t0 (current-time-ms))
(display "Figure 10.3 — semi-gradient n-step Sarsa, mountain car, steps per episode (")
(display runs) (display " run(s))") (newline)
(display "  n   alpha    ep1    ep2    ep5   ep10  mean 1-") (display (quotient episodes 2))
(display "  mean ") (display (+ 1 (quotient episodes 2))) (display "-") (display episodes) (newline)
(define (at c k) (display (string-pad-left (number->string (round (vector-ref c (- k 1)))) 7)))
(define (show n label c)
  (display (string-pad-left (number->string n) 3)) (display (string-pad-left label 8))
  (at c 1) (at c 2) (at c 5) (at c 10)
  (display (string-pad-left (number->string (round-to (avg-of c 0 (quotient episodes 2)) 1)) 10))
  (display (string-pad-left (number->string (round-to (avg-of c (quotient episodes 2) episodes) 1)) 12))
  (newline))
(show 1 "0.5/8" (curve-for 1 0.5))
(show 8 "0.3/8" (curve-for 8 0.3))
(display "(") (display (- (current-time-ms) t0)) (display " ms)") (newline)
(display "done") (newline)
