; Chapter 8 oracle: mazes, the Dyna-Q / Dyna-Q+ model, Figure 8.2 and 8.4 shape.
(require "rl/check" all:)
(require "rl/rng" all:)
(require "rl/vec" all:)
(require "envs/maze" all:)
(require "algos/dyna" all:)

; --- maze dynamics
(define dm (dyna-maze))
(check-true "maze: wall at (2,2) blocks right from (2,1)" (= (car (maze-step dm 19 3)) 19))
(check-true "maze: top edge leaves (0,0) in place" (= (car (maze-step dm 0 0)) 0))
(define g (maze-step dm 17 0))
(check-true "maze: up from (1,8) reaches the goal, reward 1, done"
            (and (= (car g) 8) (= (cadr g) 1.0) (car (cddr g))))
(check-true "maze: ordinary step pays 0" (= (cadr (maze-step dm 18 1)) 0.0))
(define bm (blocking-maze))
(check-true "blocking maze: (4,8) up open before the change" (= (car (maze-step bm 44 0)) 35))
(maze-switch! bm)
(check-true "blocking maze: (4,8) up blocked after the change" (= (car (maze-step bm 44 0)) 44))
(check-true "blocking maze: (4,0) up open after the change" (= (car (maze-step bm 36 0)) 27))
(define sm (maze-switch! (shortcut-maze)))
(check-true "shortcut maze: (4,8) up open after the change, (4,0) still open"
            (and (= (car (maze-step sm 44 0)) 35) (= (car (maze-step sm 36 0)) 27)))

; --- model
(define m0 (dm-new 54 4 #f))
(dm-feed! m0 18 3 19 0.0)
(check-true "Dyna-Q model: only the tried action is known"
            (and (dm-known? m0 18 3) (not (dm-known? m0 18 0)) (= (dm-next m0 18 3) 19)))
(define mp (dm-new 54 4 #t))
(dm-feed! mp 18 3 19 0.0)
(check-true "Dyna-Q+ model: untried actions known as stay-in-place, reward 0"
            (and (dm-known? mp 18 0) (= (dm-next mp 18 0) 18) (= (dm-rew mp 18 0) 0.0)
                 (= (dm-next mp 18 3) 19) (= (dm-nstates mp) 1)))
(dm-feed! mp 18 3 19 0.0)
(check-true "model: a state is listed once" (= (dm-nstates mp) 1))

; --- Figure 8.2 shape: 1 run x 15 episodes, n = 0 vs n = 10
(define c0 (dyna-curve! dyna-maze 0 1 15 2026 0.1 0.1 0.95))
(define c10 (dyna-curve! dyna-maze 10 1 15 2026 0.1 0.1 0.95))
(check-true "fig8.2 first episode identical for n=0 and n=10 (planning has its own PRNG)"
            (= (vector-ref c0 0) (vector-ref c10 0)))
(define (mean-from v lo hi acc) (if (< lo hi) (mean-from v (+ lo 1) hi (+ acc (vector-ref v lo))) acc))
(define t0 (/ (mean-from c0 5 15 0.0) 10.0))
(define t10 (/ (mean-from c10 5 15 0.0) 10.0))
(check-true "fig8.2 n=10 needs far fewer steps than n=0 in episodes 6-15" (< (* 3.0 t10) t0))
(check-range "fig8.2 n=10 episodes 6-15 near the 14-step optimum (eps=0.1)" t10 14.0 25.0)

; --- Figure 8.4 shape: blocking maze, 1 run, 2000 steps (switch at 1000)
(define bq (dyna-cumulative! blocking-maze #f 2000 1000 10 1 2026 0.1 1.0 0.95 0.0001))
(define bqp (dyna-cumulative! blocking-maze #t 2000 1000 10 1 2026 0.1 1.0 0.95 0.0001))
(check-true "fig8.4 both methods reach the goal often before the change"
            (and (> (vector-ref bq 999) 30.0) (> (vector-ref bqp 999) 30.0)))
(check-true "fig8.4 the change stalls Dyna-Q: fewer goals in steps 1001-1200 than in 801-1000"
            (< (- (vector-ref bq 1199) (vector-ref bq 999)) (- (vector-ref bq 999) (vector-ref bq 799))))
(check-true "fig8.4 Dyna-Q+ gains at least as much as Dyna-Q after the change"
            (>= (- (vector-ref bqp 1999) (vector-ref bqp 999)) (- (vector-ref bq 1999) (vector-ref bq 999))))
