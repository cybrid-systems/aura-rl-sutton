; Chapter 7 oracle: n-step TD (random walk), n-step Sarsa / Expected Sarsa / Tree Backup.
(require "rl/check" all:)
(require "rl/rng" all:)
(require "rl/vec" all:)
(require "envs/cliffwalking" all:)
(require "algos/td" all:)
(require "algos/nstep" all:)

(define (max-abs-diff a b)
  (let lp ((i 0) (m 0.0))
    (if (< i (vector-length a))
        (lp (+ i 1) (max m (abs (- (vector-ref a i) (vector-ref b i)))))
        m)))

; n = 1 reduces to the one-step methods: same seed → identical Q tables.
(define (q-after-td method eps)
  (let ((q (make-vector 192 0.0)))
    (rng-seed! 99)
    (let ep ((i 0))
      (if (< i eps) (begin (td-control-episode! method q cw-step cw-start 4 0.1 0.5 1.0) (ep (+ i 1))) #f))
    q))
(define (q-after-ns method eps)
  (let ((q (make-vector 192 0.0)))
    (rng-seed! 99)
    (let ep ((i 0))
      (if (< i eps) (begin (ns-control-episode! method q cw-step cw-start 4 1 0.1 0.5 1.0) (ep (+ i 1))) #f))
    q))
(check-near "7.2 n=1 Sarsa == one-step Sarsa (Q after 15 eps)"
            (max-abs-diff (q-after-td 'sarsa 15) (q-after-ns 'sarsa 15)) 0.0 1e-9)
(check-near "7.5 n=1 Expected Sarsa == one-step Expected Sarsa"
            (max-abs-diff (q-after-td 'expected 15) (q-after-ns 'expected 15)) 0.0 1e-9)
(check-near "7.5 n=1 Tree Backup == Q-learning"
            (max-abs-diff (q-after-td 'q 15) (q-after-ns 'tree 15)) 0.0 1e-9)

; n larger than any episode, α = 1: n-step TD is Monte Carlo — every visited
; state takes the episode's return (±1), unvisited states stay 0.
(rng-seed! 5)
(define vmc (make-vector 21 0.0))
(ns-td-episode! vmc 19 100000 1.0)
(define (mc-shape v)
  (let lp ((s 1) (ok #t) (seen 0) (g 0.0))
    (if (<= s 19)
        (let ((x (vector-ref v s)))
          (if (= x 0.0)
              (lp (+ s 1) ok seen g)
              (lp (+ s 1) (and ok (= (abs x) 1.0) (or (= seen 0) (= x g))) (+ seen 1) x)))
        (and ok (> seen 0)))))
(check-true "7.1 n=inf, alpha=1: visited states all equal the return (+-1)" (mc-shape vmc))
(check-near "7.1 terminal values stay 0" (+ (abs (vector-ref vmc 0)) (abs (vector-ref vmc 20))) 0.0 1e-12)

; Figure 7.2 shape (5 runs × 10 episodes)
(rng-seed! 2026)
(define r1 (ns-td-rms! 19 1 0.4 5 10))
(rng-seed! 2026)
(define r4 (ns-td-rms! 19 4 0.4 5 10))
(rng-seed! 2026)
(define r16 (ns-td-rms! 19 16 1.0 5 10))
(check-true "fig7.2 n=4 beats n=1 at alpha=0.4" (< r4 r1))
(check-range "fig7.2 n=4 alpha=0.4 RMS (book ~0.3)" r4 0.18 0.42)
(check-range "fig7.2 n=1 alpha=0.4 RMS (book ~0.45)" r1 0.35 0.55)
(check-true "fig7.2 n=16 alpha=1 is worse than n=4 alpha=0.4" (> r16 r4))

; n-step control on cliff walking: online rewards and greedy paths.
(define (train method n episodes)
  (let ((q (make-vector 192 0.0)) (acc (make-vector 1 0.0)))
    (let ep ((i 0))
      (if (< i episodes)
          (let ((r (car (ns-control-episode! method q cw-step cw-start 4 n 0.1 0.2 1.0))))
            (if (>= i (quotient episodes 2)) (vec-add-at! acc 0 r) #f)
            (ep (+ i 1)))
          #f))
    (cons (/ (vector-ref acc 0) (- episodes (quotient episodes 2)))
          (- (length (td-greedy-path q cw-step cw-start 4 100)) 1))))
(rng-seed! 2026)
(define s2 (train 'sarsa 2 200))
(rng-seed! 2026)
(define t2 (train 'tree 2 200))
(check-range "7.2 2-step Sarsa online reward (eps 101-200, book-like ~-25)" (car s2) -45.0 -14.0)
(check-true "7.5 2-step Tree Backup (off-policy, greedy target) scores worse online than Sarsa"
            (< (car t2) (car s2)))
(check-range "7.5 2-step Tree Backup greedy path reaches the goal near the edge (13 = optimal)" (cdr t2) 13 17)
