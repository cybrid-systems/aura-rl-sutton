; Chapters 3–4 oracle: published gridworld values (1 decimal).
(require "rl/check" all:)
(require "envs/gridworld" all:)
(require "algos/dp" all:)

; --- Ch3 5×5 gridworld
(define (m5 s a)
  (cond ((= s 1) (dp-det 21 10.0))
        ((= s 3) (dp-det 13 5.0))
        (else (let ((m (gw-move 5 5 (gw-row 5 s) (gw-col 5 s) a)))
                (dp-det (gw-index 5 (car m) (cadr m)) (if (car (cddr m)) -1.0 0.0))))))
(define v32 (make-vector 25 0.0))
(dp-policy-eval! v32 25 4 m5 (lambda (s a) 0.25) 0.9 1.0e-5 (lambda (s) #f) #t)
(check-near "fig3.2 v(A)" (vector-ref v32 1) 8.8 0.05)
(check-near "fig3.2 v(B)" (vector-ref v32 3) 5.3 0.05)
(check-near "fig3.2 v(0,0)" (vector-ref v32 0) 3.3 0.05)
(check-near "fig3.2 v(4,4)" (vector-ref v32 24) -2.0 0.05)
(define v35 (make-vector 25 0.0))
(dp-value-iteration! v35 25 4 m5 0.9 1.0e-5 (lambda (s) #f))
(check-near "fig3.5 v*(A)" (vector-ref v35 1) 24.4 0.05)
(check-near "fig3.5 v*(B)" (vector-ref v35 3) 19.4 0.05)
(check-near "fig3.5 v*(4,4)" (vector-ref v35 24) 11.7 0.05)

; --- Ch4 4×4 gridworld
(define (term4 s) (or (= s 0) (= s 15)))
(define (m4 s a)
  (let ((m (gw-move 4 4 (gw-row 4 s) (gw-col 4 s) a)))
    (dp-det (gw-index 4 (car m) (cadr m)) -1.0)))
(define v41 (make-vector 16 0.0))
(define k-in (dp-policy-eval! v41 16 4 m4 (lambda (s a) 0.25) 1.0 1.0e-4 term4 #t))
(check-near "fig4.1 v(1)" (vector-ref v41 1) -14.0 0.05)
(check-near "fig4.1 v(2)" (vector-ref v41 2) -20.0 0.05)
(check-near "fig4.1 v(3)" (vector-ref v41 3) -22.0 0.05)
(check-near "fig4.1 v(5)" (vector-ref v41 5) -18.0 0.05)
(define v-sync (make-vector 16 0.0))
(define k-sync (dp-policy-eval! v-sync 16 4 m4 (lambda (s a) 0.25) 1.0 1.0e-4 term4 #f))
(check-true "in-place converges in fewer sweeps" (< k-in k-sync))
(define vpi (make-vector 16 0.0))
; Start from a proper policy (greedy w.r.t. v_random): with γ=1 an improper
; initial policy (e.g. "always up") has unbounded values and evaluation never converges.
(define pol (make-vector 16 0))
(let lp ((s 0)) (if (< s 16) (begin (vector-set! pol s (dp-greedy-action m4 v41 s 4 1.0)) (lp (+ s 1))) #f))
(dp-policy-iteration! vpi pol 16 4 m4 1.0 1.0e-4 term4)
(check-near "policy iteration v*(3)" (vector-ref vpi 3) -3.0 1.0e-6)
(check-near "policy iteration v*(5)" (vector-ref vpi 5) -2.0 1.0e-6)
