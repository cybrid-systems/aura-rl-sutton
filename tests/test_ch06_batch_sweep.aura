; Chapter 6 oracle (part 2): batch updating (Figure 6.2), α sweep on cliff walking (Figure 6.3).
(require "rl/check" all:)
(require "rl/rng" all:)
(require "rl/vec" all:)
(require "envs/cliffwalking" all:)
(require "algos/td" all:)
(require "algos/td-batch" all:)

; Figure 6.2 — batch TD(0) vs batch MC, α = 0.001, 5 runs × 40 episodes
(rng-seed! 2026)
(define btd (td-batch-rms! 'td 0.001 5 40))
(rng-seed! 2026)
(define bmc (td-batch-rms! 'mc 0.001 5 40))
(check-near "fig6.2 initial RMS (all 0.5)" (vector-ref btd 0) 0.2357 0.001)
(check-true "fig6.2 batch TD below batch MC after 10 episodes" (< (vector-ref btd 10) (vector-ref bmc 10)))
(check-true "fig6.2 batch TD below batch MC after 40 episodes" (< (vector-ref btd 40) (vector-ref bmc 40)))
(check-range "fig6.2 batch TD RMS after 40 episodes" (vector-ref btd 40) 0.02 0.12)

; Figure 6.3 — at α = 1, Expected Sarsa is far better online than Sarsa and Q-learning.
(define (perf method alpha runs eps)
  (let ((acc (make-vector 1 0.0)))
    (let run ((k 0))
      (if (< k runs)
          (let ((q (make-vector 192 0.0)))
            (let ep ((i 0))
              (if (< i eps)
                  (begin (vec-add-at! acc 0 (car (td-control-episode! method q cw-step cw-start 4 0.1 alpha 1.0)))
                         (ep (+ i 1)))
                  #f))
            (run (+ k 1)))
          #f))
    (/ (vector-ref acc 0) (* 1.0 runs eps))))
(rng-seed! 2026)
(define e1 (perf 'expected 1.0 3 60))
(define s1 (perf 'sarsa 1.0 3 60))
(define q1 (perf 'q 1.0 3 60))
(check-true "fig6.3 alpha=1: Expected Sarsa > Sarsa (interim)" (> e1 s1))
(check-true "fig6.3 alpha=1: Expected Sarsa > Q-learning (interim)" (> e1 q1))
(check-range "fig6.3 alpha=1: Expected Sarsa interim reward" e1 -80.0 -30.0)
