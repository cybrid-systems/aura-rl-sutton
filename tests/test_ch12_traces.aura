; Chapter 12 oracle: offline lambda-return, TD(lambda) and true online TD(lambda)
; on the 19-state walk must match tests/oracle/lambda_walk.py, an independent
; Python implementation that replays the same Park-Miller PRNG (seed 7, 10 runs
; x 10 episodes, capped mean RMS). Then Sarsa(lambda) / true online Sarsa(lambda)
; on mountain car must learn.
(require "rl/check" all:)
(require "rl/rng" all:)
(require "algos/traces" all:)
(require "algos/sarsa-lambda" all:)

(check-near "walk19: v_pi(1) = -0.9" (vector-ref lam-truth 1) -0.9 0.0000001)
(check-near "walk19: v_pi(19) = 0.9" (vector-ref lam-truth 19) 0.9 0.0000001)

(rng-seed! 7)
(define acc (make-vector 7 0.0))
(define cfg (vector (vector 0 0.8 0.4) (vector 1 0.8 0.4) (vector 2 0.8 0.4) (vector 0 0.0 0.6)
                    (vector 1 0.9 0.3) (vector 2 0.975 0.2) (vector 1 1.0 0.9)))
(define (one c) (let ((x (vector-ref cfg c))) (lam-run-config (vector-ref x 0) (vector-ref x 1) (vector-ref x 2))))
(define (cfgs c) (if (< c 7) (begin (vector-set! acc c (+ (vector-ref acc c) (one c))) (cfgs (+ c 1))) #t))
(define (runs r) (if (< r 10) (begin (lam-gen-run! 10) (cfgs 0) (runs (+ r 1))) #t))
(runs 0)
(define (m c) (/ (vector-ref acc c) 100.0))
(check-near "fig12.3 offline lambda-return, lambda 0.8, alpha 0.4 (python 0.2466736)" (m 0) 0.24667363 0.000001)
(check-near "fig12.6 TD(lambda), lambda 0.8, alpha 0.4 (python 0.2550926)" (m 1) 0.25509260 0.000001)
(check-near "fig12.8 true online TD(lambda), lambda 0.8, alpha 0.4 (python 0.2402547)" (m 2) 0.24025471 0.000001)
(check-near "fig12.3 offline lambda-return, lambda 0, alpha 0.6 (python 0.3827745)" (m 3) 0.38277448 0.000001)
(check-near "fig12.6 TD(lambda), lambda 0.9, alpha 0.3 (python 0.3017725)" (m 4) 0.30177254 0.000001)
(check-near "fig12.8 true online TD(lambda), lambda 0.975, alpha 0.2 (python 0.3538390)" (m 5) 0.35383901 0.000001)
(check-near "fig12.6 TD(1) at alpha 0.9 diverges (capped at 1.0)" (m 6) 1.0 0.0)
(check-true "fig12.8 true online beats TD(lambda) at lambda 0.8, alpha 0.4" (< (m 2) (m 1)))

; --- mountain car: Sarsa(lambda) learns, every method terminates
(rng-seed! 2026)
(define ag (sl-new 0 0.5 0.9))
(define e1 (sl-episode! ag 5000))
(define (more k acc) (if (> k 0) (more (- k 1) (+ acc (sl-episode! ag 5000))) acc))
(define (skip k) (if (> k 0) (begin (sl-episode! ag 5000) (skip (- k 1))) #t))
(skip 5)
(define late (/ (more 4 0) 4.0))
(check-true "fig12.10 Sarsa(0.9) replacing: first episode > 400 steps" (> e1 400))
(check-range "fig12.10 Sarsa(0.9) replacing: mean of episodes 7-10" late 100.0 450.0)
(define ag2 (sl-new 2 0.5 0.9))
(define t1 (sl-episode! ag2 5000))
(define t2 (sl-episode! ag2 5000))
(define t3 (sl-episode! ag2 5000))
(check-true "fig12.11 true online Sarsa(0.9): episodes terminate below the cap" (if (< t1 5000) (if (< t2 5000) (< t3 5000) #f) #f))
(check-true "fig12.11 true online Sarsa(0.9): third episode shorter than the first" (< t3 t1))
(define ag3 (sl-new 1 0.3 0.9))
(define a1 (sl-episode! ag3 5000))
(check-true "fig12.11 accumulating Sarsa(0.9): first episode terminates" (< a1 5000))
