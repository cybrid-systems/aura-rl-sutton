; Chapter 9 oracle: polynomial and Fourier features (Sec 9.5.2) and gradient MC
; with them on the 1000-state walk (Fig 9.5 shape).
(require "rl/check" all:)
(require "rl/rng" all:)
(require "oracle/walk1000-exact" all:)
(require "algos/basis" all:)

(rng-seed! 2026)
(define p (bs-new 0 2 0.0))
(define f (bs-new 1 2 0.0))
; features at s = 500 (x = 0.5): polynomial 1, 0.5, 0.25; Fourier 1, cos(pi/2) = 0, cos(pi) = -1
(define (feat bs s i) (vector-ref (vector-ref bs 1) (+ (* (- s 1) 3) i)))
(check-near "poly: x^0 at s=500" (feat p 500 0) 1.0 0.0)
(check-near "poly: x^1 at s=500" (feat p 500 1) 0.5 0.0000001)
(check-near "poly: x^2 at s=500" (feat p 500 2) 0.25 0.0000001)
(check-near "fourier: cos(0) at s=500" (feat f 500 0) 1.0 0.0)
(check-near "fourier: cos(pi/2) at s=500" (feat f 500 1) 0.0 0.0000001)
(check-near "fourier: cos(pi) at s=500" (feat f 500 2) -1.0 0.0000001)
(check-near "fourier: cos(2 pi) at s=1000" (feat f 1000 2) 1.0 0.0000001)
(define r0 (bs-rms f w1k-true))
(check-range "zero weights: RMS = RMS of v_pi" r0 0.5 0.65)

(define (train bs k) (if (> k 0) (begin (bs-mc-episode! bs) (train bs (- k 1))) bs))
(define fp (train (bs-new 0 5 0.0001) 150))
(define ff (train (bs-new 1 5 0.00005) 150))
(check-true "fig9.5 polynomial order 5: 150 episodes lower the error" (< (bs-rms fp w1k-true) (- r0 0.02)))
(check-true "fig9.5 Fourier order 5: 150 episodes lower the error" (< (bs-rms ff w1k-true) (- r0 0.01)))
(check-true "fig9.5 values are increasing in the state after training (poly)" (< (bs-value fp 100) (bs-value fp 900)))
