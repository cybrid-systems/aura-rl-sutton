; Chapter 5 oracle: blackjack MC vs exact DP values (lib/oracle, generated by
; tests/oracle/blackjack_exact.py) and the book's Figure 5.3 true value.
(require "rl/check" all:)
(require "rl/rng" all:)
(require "rl/vec" all:)
(require "envs/blackjack" all:)
(require "algos/mc" all:)
(require "oracle/blackjack-exact" all:)

(define (rms v ref lo hi)
  (let lp ((s lo) (acc 0.0))
    (if (< s hi)
        (let ((e (- (vector-ref v s) (vector-ref ref s)))) (lp (+ s 1) (+ acc (* e e))))
        (sqrt (/ acc (- hi lo))))))
(define (same? a b)
  (let lp ((i 0))
    (if (>= i (vector-length a)) #t
        (if (= (vector-ref a i) (vector-ref b i)) (lp (+ i 1)) #f))))
(define (agree pi lo hi)
  (let lp ((s lo) (n 0))
    (if (< s hi)
        (lp (+ s 1) (if (= (vector-ref pi s) (vector-ref bj-exact-pistar s)) (+ n 1) n))
        n)))
(define (policy-of pi)
  (lambda (sum usable show) (mc-index-act (vector-ref pi (bj-state-index sum usable show)))))

; oracle self-checks (book: Fig 5.3 state value -0.27726; optimal policy shape)
(check-near "exact v(13,usable,2) = book -0.27726"
            (vector-ref bj-exact-v20 (bj-state-index 13 #t 2)) -0.27726 0.001)
(check-true "exact pi*: stick on 12 vs dealer 4..6, hit vs 2,3"
            (and (= 0 (vector-ref bj-exact-pistar (bj-state-index 12 #f 4)))
                 (= 0 (vector-ref bj-exact-pistar (bj-state-index 12 #f 6)))
                 (= 1 (vector-ref bj-exact-pistar (bj-state-index 12 #f 3)))))
(check-true "exact pi*: usable 18 sticks vs 8, hits vs 9"
            (and (= 0 (vector-ref bj-exact-pistar (bj-state-index 18 #t 8)))
                 (= 1 (vector-ref bj-exact-pistar (bj-state-index 18 #t 9)))))

; Fig 5.1 — first-visit == every-visit (no repeated states in blackjack)
(rng-seed! 11)
(define fv (car (mc-bj-predict! bj-stick-20-policy 2000 #t)))
(rng-seed! 11)
(define ev (car (mc-bj-predict! bj-stick-20-policy 2000 #f)))
(check-true "fig5.1 first-visit == every-visit" (same? fv ev))

; Fig 5.1 — 10k episodes against exact v_π
(rng-seed! 2026)
(define pred (car (mc-bj-predict! bj-stick-20-policy 10000 #t)))
(check-range "fig5.1 RMS no usable ace (10k)" (rms pred bj-exact-v20 0 100) 0.0 0.12)
(check-range "fig5.1 RMS usable ace (10k)" (rms pred bj-exact-v20 100 200) 0.0 0.40)
(check-near "fig5.1 v(21, no ace, dealer 10)"
            (vector-ref pred (bj-state-index 21 #f 10))
            (vector-ref bj-exact-v20 (bj-state-index 21 #f 10)) 0.08)

; Fig 5.2 — Monte Carlo ES
(rng-seed! 2026)
(define es (mc-bj-es! 30000))
(check-range "fig5.2 MC ES agrees with pi* (no ace, sum 17..21)" (agree (car es) 50 100) 45 50)
(check-range "fig5.2 MC ES agrees with pi* (no ace, all)" (agree (car es) 0 100) 80 100)
(check-range "fig5.2 MC ES greedy mean return (optimal -0.047)"
             (mc-bj-mean-return! (policy-of (car es)) 4000) -0.12 0.03)

; Sec 5.4 — ε-soft on-policy control beats the stick-20 policy (-0.354)
(rng-seed! 2026)
(define soft (mc-bj-eps-soft! 10000 0.1))
(check-range "sec5.4 eps-soft greedy mean return"
             (mc-bj-mean-return! (policy-of (car soft)) 4000) -0.20 0.03)

; Fig 5.3 — weighted IS has lower error than ordinary IS (averaged over the curve)
(rng-seed! 2026)
(define off (mc-bj-off-policy! 50 100 -0.27726))
(define (vmean v) (/ (vec-sum v) (vector-length v)))
(check-true "fig5.3 mean WIS MSE < mean OIS MSE (eps 1-100)" (< (vmean (cadr off)) (vmean (car off))))
(check-range "fig5.3 WIS MSE at 100 episodes" (vector-ref (cadr off) 99) 0.0 0.12)

; Fig 5.4 — ordinary IS estimates are unbiased but heavy tailed: finite, ≥ 0
(rng-seed! 2026)
(define iv (mc-inf-var! 2000))
(check-range "fig5.4 OIS estimate after 2000 episodes" (vector-ref iv 1999) 0.0 10.0)
